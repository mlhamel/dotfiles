{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.3:cloud",
  "instructions": ["~/.config/opencode/agent_sssm_instructions.md"],
  "experimental": {
    "todo": true
  },
  "agents": {
    "title": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "compaction": {
      "system": "You are a state compressor (SSSM). Produce a brief oriented toward future actions. Include only: 1) The task's main objective and acceptance criteria, 2) The current state of the code and tests, 3) The relevant files and their paths, 4) The exact next action to execute. Strictly exclude verbose build/test logs, past explanations, and already-resolved failed attempts."
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20480
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 16384 },
    "buffer": "25%"
  },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "Qwen3 4B (local)",
          "limit": { "context": 65536 }
        },
        "glm-5.3:cloud": {
          "name": "glm-5.3:cloud",
          "limit": { "context": 65536 }
        },
        "glm-5.3-flash:cloud": {
          "name": "glm-5.3-flash:cloud",
          "limit": { "context": 65536 }
        },
        "glm-5.2:cloud": {
          "name": "glm-5.2:cloud",
          "limit": { "context": 65536 }
        },
        "gemma4:cloud": {
          "name": "gemma4:cloud",
          "limit": { "context": 65536 }
        },
        "kimi-k2.7-code:cloud": {
          "name": "kimi-k2.7-code:cloud",
          "limit": { "context": 65536 }
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "curl * | bash", "effect": "deny" },
    { "action": "shell", "resource": "wget * | bash", "effect": "deny" }
  ]
}
