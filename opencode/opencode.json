{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.3:cloud",
  "small_model": "ollama/glm-5.2:cloud",
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20480
  },
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "Qwen3 4B (local)"
        },
        "glm-5.3:cloud": {
          "name": "glm-5.3:cloud"
        },
        "glm-5.2:cloud": {
          "name": "glm-5.2:cloud"
        },
        "gemma4:cloud": {
          "name": "gemma4:cloud"
        },
        "kimi-k2.7-code:cloud": {
          "name": "kimi-k2.7-code:cloud"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "git push *": "deny",
      "curl * | bash": "deny",
      "wget * | bash": "deny"
    }
  }
}
