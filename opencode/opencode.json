{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/glm-5.3-flash:cloud",
  "instructions": ["~/.config/opencode/agent_sssm_instructions.md"],
  "experimental": {
    "todo": true
  },
  "agents": {
    "title": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "plan": {
      "model": "ollama/glm-5.3-flash:cloud"
    },
    "compaction": {
      "system": "You are a state compressor (SSSM). Produce a brief oriented toward future actions. Include only: 1) The task's main objective and acceptance criteria, 2) The current state of the code and tests, 3) The relevant files and their paths, 4) The exact next action to execute. Strictly exclude verbose build/test logs, past explanations, and already-resolved failed attempts."
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20480
  },
  "compaction": {
    "auto": true,
    "keep": { "tokens": 16384 },
    "buffer": "25%"
  },
  "providers": {
    "ollama": {
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "Qwen3 4B (local)",
          "limit": { "context": 65536 }
        },
        "glm-5.3:cloud": {
          "name": "glm-5.3:cloud",
          "limit": { "context": 65536 }
        },
        "glm-5.3-flash:cloud": {
          "name": "glm-5.3-flash:cloud",
          "limit": { "context": 65536 }
        },
        "glm-5.2:cloud": {
          "name": "glm-5.2:cloud",
          "limit": { "context": 65536 }
        },
        "gemma4:cloud": {
          "name": "gemma4:cloud",
          "limit": { "context": 65536 }
        },
        "kimi-k2.7-code:cloud": {
          "name": "kimi-k2.7-code:cloud",
          "limit": { "context": 65536 }
        },
        "inkling-2-small:cloud": {
          "name": "inkling-2-small:cloud",
          "limit": { "context": 65536 }
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "curl * | bash", "effect": "deny" },
    { "action": "shell", "resource": "curl * | sh", "effect": "deny" },
    { "action": "shell", "resource": "wget * | bash", "effect": "deny" },
    { "action": "shell", "resource": "wget * | sh", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "eval *", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/*", "effect": "deny" },
    { "action": "read", "resource": "~/.azure/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/*", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.gnupg/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.aws/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/gh/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/gcloud/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.azure/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.kube/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.docker/*",
      "effect": "deny"
    }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *", "effect": "deny" },
    {
      "action": "tool.use",
      "resource": "shell:curl * | bash",
      "effect": "deny"
    },
    { "action": "tool.use", "resource": "shell:curl * | sh", "effect": "deny" },
    {
      "action": "tool.use",
      "resource": "shell:wget * | bash",
      "effect": "deny"
    },
    { "action": "tool.use", "resource": "shell:wget * | sh", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:eval *", "effect": "deny" }
  ]
}
