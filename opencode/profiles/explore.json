{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "effect": "deny", "resource": "*" },
    { "action": "shell", "effect": "ask", "resource": "*" },
    { "action": "shell", "effect": "allow", "resource": "git status *" },
    { "action": "shell", "effect": "allow", "resource": "git diff *" },
    { "action": "shell", "effect": "allow", "resource": "git log *" },
    { "action": "shell", "effect": "allow", "resource": "git show *" },
    { "action": "shell", "effect": "allow", "resource": "ls *" },
    { "action": "shell", "effect": "allow", "resource": "cat *" },
    { "action": "shell", "effect": "deny", "resource": "sudo *" },
    { "action": "shell", "effect": "deny", "resource": "rm *" },
    { "action": "shell", "effect": "deny", "resource": "curl * | bash" },
    { "action": "shell", "effect": "deny", "resource": "curl * | sh" },
    { "action": "shell", "effect": "deny", "resource": "wget * | bash" },
    { "action": "shell", "effect": "deny", "resource": "wget * | sh" },
    { "action": "shell", "effect": "deny", "resource": "git push *" },
    { "action": "shell", "effect": "deny", "resource": "eval *" },
    { "action": "read", "effect": "deny", "resource": "~/.ssh/*" },
    { "action": "read", "effect": "deny", "resource": "~/.gnupg/*" },
    { "action": "read", "effect": "deny", "resource": "~/.aws/*" },
    { "action": "read", "effect": "deny", "resource": "~/.config/gh/*" },
    { "action": "read", "effect": "deny", "resource": "~/.config/gcloud/*" },
    { "action": "read", "effect": "deny", "resource": "~/.azure/*" },
    { "action": "read", "effect": "deny", "resource": "~/.kube/*" },
    { "action": "read", "effect": "deny", "resource": "~/.docker/*" },
    { "action": "read", "effect": "deny", "resource": "~/.npmrc" },
    { "action": "read", "effect": "deny", "resource": "~/.netrc" },
    { "action": "read", "effect": "deny", "resource": "*.pem" },
    { "action": "read", "effect": "deny", "resource": "*.key" },
    { "action": "read", "effect": "deny", "resource": "*.env" },
    { "action": "read", "effect": "deny", "resource": "*.env.*" },
    { "action": "read", "effect": "allow", "resource": "*.env.example" },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.ssh/*"
    },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.gnupg/*"
    },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.aws/*"
    },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.config/gh/*"
    },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.config/gcloud/*"
    },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.azure/*"
    },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.kube/*"
    },
    {
      "action": "external_directory",
      "effect": "deny",
      "resource": "~/.docker/*"
    }
  ]
}
