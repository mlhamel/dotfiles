# versions.env — central version pins, the single source of truth.
# Consumers source this file: setup.sh (OPENCODE_VERSION),
# opencode/setup-director.sh (DIRECTOR_VERSION), openhands/openhands.sh
# (all three), and .github/workflows/measure.yml greps OPENCODE_VERSION.
# Assignments keep any pre-set environment value, so an explicit
# OPENCODE_VERSION=x.y.z override always wins over the file.
export OPENCODE_VERSION="${OPENCODE_VERSION:-2.4.2}"
export DIRECTOR_VERSION="${DIRECTOR_VERSION:-v1.23.0}"
export AGENT_CANVAS_VERSION="${AGENT_CANVAS_VERSION:-1.46.0}"
